# Variables para Vercel (Settings > Environment Variables).
# 1. Copia este contenido, reemplaza cada VALOR y pegalo en el primer campo "Key" de Vercel:
#    Vercel separa las lineas en variables automaticamente.
# 2. NO subas a git una copia con valores reales (.env.vercel esta en .gitignore).

ConnectionStrings__SupabaseConnection=User Id=postgres.TU_REF;Password=TU_PASSWORD;Server=aws-1-us-east-1.pooler.supabase.com;Port=5432;Database=postgres;SSL Mode=Require
Spotify__ClientId=TU_CLIENT_ID
Spotify__ClientSecret=TU_CLIENT_SECRET
